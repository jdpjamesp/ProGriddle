/* The pictures of Blast Buddies, by name: every sprite of the design, as the rows of a Tile (see there) with its size, its origin
   (the column and row of the point that stands on the ground, one row below the picture for anything that stands), the letters
   of its legend as 'A=RRGGBB' pairs and the name of the tone row its digits 1 to 5 use ('' when it has none). Generated by tools/gen-blast-art.ps1 from docs/design/blast-buddies-art.md. Do not edit by hand: change the design and run the script again. */
USING Progress.Lang.*.
USING ProGriddle.Core.*.
USING ProGriddle.Engine.*.

BLOCK-LEVEL ON ERROR UNDO, THROW.

CLASS ProGriddle.Games.BlastBuddies.BuddiesArt FINAL:

    /* every sprite name, in the order of the design */
    DEFINE PRIVATE STATIC VARIABLE sNames AS CHARACTER NO-UNDO INITIAL "goon_idle_1,goon_idle_2,goon_blink,goon_look_back,goon_worried,goon_grin,goon_walk_1,goon_walk_2,goon_walk_3,goon_walk_4,goon_jump_rise,goon_jump_fall,goon_aim,goon_flinch,goon_fly_1,goon_fly_2,goon_land,goon_alarm_1,goon_alarm_2,goon_alarm_3,goon_sink,goon_dance_1,goon_dance_2,goon_dance_3,goon_shiver,goon_taunt,goon_flip_1,goon_flip_2,goon_flip_3,goon_flip_4,mark_reds,mark_blues,mark_teals,mark_grapes,held_bazooka,held_grenade,held_dynamite,held_shotgun,held_radio,rocket,exhaust_0,exhaust_1,grenade,dynamite,fuse_spark_0,fuse_spark_1,muzzle_0,muzzle_1,flare_0,flare_1,missile,mine_0,mine_1,crate_health,crate_weapon,chute_0,chute_1,icon_bazooka,icon_grenade,icon_dynamite,icon_shotgun,icon_airstrike,icon_selected,reticle_0,reticle_1,halo,gravestone,ico_heart,ico_alert,ico_think,ico_skull,bubble_oof".

    /* How many sprites there are. */
    METHOD PUBLIC STATIC INTEGER Count():
        RETURN 72.
    END METHOD.

    /* The name of sprite 1 to Count. Throws GridException outside that. */
    METHOD PUBLIC STATIC CHARACTER NameAt(INPUT piIndex AS INTEGER):
        IF piIndex = ? OR piIndex < 1 OR piIndex > Count() THEN UNDO, THROW NEW GridException("There is no sprite " + STRING(piIndex)).
        RETURN ENTRY(piIndex, sNames).
    END METHOD.

    /* True when the design has a sprite of that name. */
    METHOD PUBLIC STATIC LOGICAL Has(INPUT pcName AS CHARACTER):
        RETURN pcName <> ? AND pcName <> "" AND LOOKUP(pcName, sNames) > 0.
    END METHOD.

    /* The width of a sprite in pixels. Throws GridException for a sprite that is not in the design. */
    METHOD PUBLIC STATIC INTEGER Width(INPUT pcName AS CHARACTER):
        RETURN INTEGER(ENTRY(1, Spec(pcName), "|")).
    END METHOD.

    /* The height of a sprite in pixels. Throws GridException for a sprite that is not in the design. */
    METHOD PUBLIC STATIC INTEGER Height(INPUT pcName AS CHARACTER):
        RETURN INTEGER(ENTRY(2, Spec(pcName), "|")).
    END METHOD.

    /* The column of a sprite's origin. Throws GridException for a sprite that is not in the design. */
    METHOD PUBLIC STATIC INTEGER OriginX(INPUT pcName AS CHARACTER):
        RETURN INTEGER(ENTRY(3, Spec(pcName), "|")).
    END METHOD.

    /* The row of a sprite's origin. Throws GridException for a sprite that is not in the design. */
    METHOD PUBLIC STATIC INTEGER OriginY(INPUT pcName AS CHARACTER):
        RETURN INTEGER(ENTRY(4, Spec(pcName), "|")).
    END METHOD.

    /* The name of the tone row (see BuddiesLook) the digits 1 to 5 of a sprite use, or "" for none. Throws GridException for a sprite that is not in the design. */
    METHOD PUBLIC STATIC CHARACTER ToneRow(INPUT pcName AS CHARACTER):
        RETURN ENTRY(5, Spec(pcName), "|").
    END METHOD.

    /* The legend of a sprite as Tile:Colourise reads it, "A=RRGGBB,B=RRGGBB" ("" for none). Throws GridException for a sprite that is not in the design. */
    METHOD PUBLIC STATIC CHARACTER Legend(INPUT pcName AS CHARACTER):
        RETURN ENTRY(6, Spec(pcName), "|").
    END METHOD.

    /* The rows of a sprite as Tile reads them, separated by "/". Throws GridException for a sprite that is not in the design. */
    METHOD PUBLIC STATIC CHARACTER Rows(INPUT pcName AS CHARACTER):
        RETURN ENTRY(7, Spec(pcName), "|").
    END METHOD.

    /* The picture of a sprite as a Tile. */
    METHOD PUBLIC STATIC Tile TileOf(INPUT pcName AS CHARACTER):
        RETURN NEW Tile(Rows(pcName)).
    END METHOD.

