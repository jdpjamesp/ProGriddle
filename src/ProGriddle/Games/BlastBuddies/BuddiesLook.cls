    /* The names of the tone rows, as a comma list. */
    METHOD PUBLIC STATIC CHARACTER ToneRowNames():
        RETURN "Reds,Blues,Teals,Grapes,Metal,Grenade,Stick,Crate,Stone,Gold,Blast,Smoke".
    END METHOD.

    /* The five hex colours of a tone row, lightest first, for Tile:Colourise. Throws GridException for an unknown row. */
    METHOD PUBLIC STATIC CHARACTER ToneRow(INPUT pcName AS CHARACTER):
        IF pcName = ? THEN UNDO, THROW NEW GridException("A tone row needs a name").
        CASE pcName:
            WHEN "Reds" THEN RETURN "F8C8C4,EF7F76,E8483C,9F342E,571F1F".
            WHEN "Blues" THEN RETURN "C5D5F8,779EEE,3D74E6,2B51A1,192F5C".
            WHEN "Teals" THEN RETURN "BCE8E2,62CABC,1FB3A0,177C72,0E4643".
            WHEN "Grapes" THEN RETURN "E1CEF6,B88DE9,9A5CE0,6A419D,3B265A".
            WHEN "Metal" THEN RETURN "D7DAE0,A2A9B7,7A8498,555C6C,2F3540".
            WHEN "Grenade" THEN RETURN "CAE1C4,83BA76,4E9C3C,376D2E,1F3D1F".
            WHEN "Stick" THEN RETURN "F4C4C4,E57575,DA3A3A,962A2C,521A1E".
            WHEN "Crate" THEN RETURN "EEDCC9,D8AD80,C88A4A,8A6037,4B3724".
            WHEN "Stone" THEN RETURN "E5E4E7,C2BFC8,A8A4B0,74727C,404049".
            WHEN "Gold" THEN RETURN "FFEDC4,FFD475,FFC23A,AF862C,5F4B1E".
            WHEN "Blast" THEN RETURN "FFF6C0,FFD54A,FF8A1E,E5402A,8A2A1E".
            WHEN "Smoke" THEN RETURN "E4DEE6,C2BAC4,9A929E,766E7A,524A56".
            OTHERWISE UNDO, THROW NEW GridException("There is no tone row called " + pcName).
        END CASE.
    END METHOD.

    /* The 0xRRGGBB number of a named colour. */
    METHOD PUBLIC STATIC INTEGER Colour(INPUT poTint AS BuddyTint):
        IF NOT VALID-OBJECT(poTint) THEN UNDO, THROW NEW GridException("A colour needs a name").
        RETURN sColour[INTEGER(poTint) + 1].
    END METHOD.

END CLASS.
