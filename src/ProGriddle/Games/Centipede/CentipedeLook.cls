        CASE piFamily:
            WHEN 1 THEN RETURN (IF piShade = 1 THEN Colour(CentipedeTint:OrchidLight) ELSE IF piShade = 2 THEN Colour(CentipedeTint:Orchid) ELSE Colour(CentipedeTint:OrchidDeep)).
