/* The 16 areas of Xevious as the design lists them (section 2.4): which ground family each has (green or dry) and its mood, a tint
   of the whole ground. The moods are numbered in the order of the design's table (dawn, day, haze, dusk, storm). After area 16 the loop starts again at 1. */
USING Progress.Lang.*.
USING ProGriddle.Core.*.
USING ProGriddle.Games.Xevious.*.

BLOCK-LEVEL ON ERROR UNDO, THROW.

CLASS ProGriddle.Games.Xevious.XeviousAreas FINAL:

    /* True when the land of an area (1 up, going round after 16) is the dry family. */
    METHOD PUBLIC STATIC LOGICAL IsDry(INPUT piArea AS INTEGER):
        CASE (piArea - 1) MODULO 16 + 1:
            WHEN 1 OR WHEN 4 OR WHEN 6 OR WHEN 8 OR WHEN 10 OR WHEN 12 OR WHEN 14 OR WHEN 16 THEN RETURN TRUE.
            OTHERWISE RETURN FALSE.
        END CASE.
    END METHOD.

    /* The mood of an area as a number: 0 for dawn and so on. */
    METHOD PUBLIC STATIC INTEGER Mood(INPUT piArea AS INTEGER):
        CASE (piArea - 1) MODULO 16 + 1:
            WHEN 1 THEN RETURN 0.
            WHEN 2 THEN RETURN 0.
            WHEN 3 THEN RETURN 1.
            WHEN 4 THEN RETURN 1.
            WHEN 5 THEN RETURN 1.
            WHEN 6 THEN RETURN 2.
            WHEN 7 THEN RETURN 2.
            WHEN 8 THEN RETURN 3.
            WHEN 9 THEN RETURN 3.
            WHEN 10 THEN RETURN 3.
            WHEN 11 THEN RETURN 1.
            WHEN 12 THEN RETURN 2.
            WHEN 13 THEN RETURN 4.
            WHEN 14 THEN RETURN 4.
            WHEN 15 THEN RETURN 3.
            WHEN 16 THEN RETURN 0.
            OTHERWISE UNDO, THROW NEW GridException("An area is 1 or more").
        END CASE.
    END METHOD.

    /* The colour a mood tints the ground with, and how many percent of the way the ground goes to it (0 for no tint). */
    METHOD PUBLIC STATIC XeviousTint MoodTint(INPUT piMood AS INTEGER):
        CASE piMood:
            WHEN 0 THEN RETURN XeviousTint:GlowLight.
            WHEN 1 THEN RETURN XeviousTint:Ink.
            WHEN 2 THEN RETURN XeviousTint:Haze.
            WHEN 3 THEN RETURN XeviousTint:DawnLow.
            WHEN 4 THEN RETURN XeviousTint:Ink.
            OTHERWISE UNDO, THROW NEW GridException("There is no mood " + STRING(piMood)).
        END CASE.
    END METHOD.

    METHOD PUBLIC STATIC INTEGER MoodPercent(INPUT piMood AS INTEGER):
        CASE piMood:
            WHEN 0 THEN RETURN 10.
            WHEN 1 THEN RETURN 0.
            WHEN 2 THEN RETURN 14.
            WHEN 3 THEN RETURN 10.
            WHEN 4 THEN RETURN 18.
            OTHERWISE UNDO, THROW NEW GridException("There is no mood " + STRING(piMood)).
        END CASE.
    END METHOD.

