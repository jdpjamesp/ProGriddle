    /* The colour a picture character stands for, or -1 for ".", which is a cell left out. A tile letter that depends on the ground
       family (# $ %) is read as the green family when plDry is false and the dry family when it is true. */
    METHOD PUBLIC STATIC INTEGER CodeColour(INPUT pcCode AS CHARACTER, INPUT plDry AS LOGICAL):
        IF pcCode = "." THEN RETURN -1.
        CASE pcCode:
            WHEN "#" THEN RETURN Colour(IF plDry THEN XeviousTint:Ochre ELSE XeviousTint:Meadow).
            WHEN "$" THEN RETURN Colour(IF plDry THEN XeviousTint:OchreLight ELSE XeviousTint:MeadowLight).
            WHEN "%" THEN RETURN Colour(IF plDry THEN XeviousTint:OchreDark ELSE XeviousTint:MeadowDark).
        END CASE.
        IF ASC(pcCode) < 48 OR ASC(pcCode) >= 48 + 67 THEN UNDO, THROW NEW GridException("No colour for picture character " + pcCode).
        RETURN Colour(XeviousTint:GetEnum(ASC(pcCode) - 48)).
    END METHOD.

