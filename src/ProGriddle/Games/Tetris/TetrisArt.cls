/* The shapes of Tetris in the "Lantern Glass" look (docs/design/tetris-art.md), every one a 16 x 16 Tile: the blank block,
   the seven pieces with their engraved marks (I a slot, O a square, T a plus, S a slash, Z a backslash, J and L their own
   hooks), the hollow ghost and the empty cell of the floor. The five tones are 1 highlight to 5 edge (see
   TetrisLook:Tones for the colour rows). The ghost uses the named colours D (its outline) and H (its hatch), the floor F
   (the cell) and G (its grid line). The blocks are made once, when the class is first used. */
USING Progress.Lang.*.
USING ProGriddle.Core.*.
USING ProGriddle.Engine.*.
USING ProGriddle.Games.Tetris.*.

BLOCK-LEVEL ON ERROR UNDO, THROW.

CLASS ProGriddle.Games.Tetris.TetrisArt FINAL:

    DEFINE PRIVATE STATIC VARIABLE sBlocks AS Tile NO-UNDO EXTENT 7.
    DEFINE PRIVATE STATIC VARIABLE sBlank  AS Tile NO-UNDO.
    DEFINE PRIVATE STATIC VARIABLE sGhost  AS Tile NO-UNDO.
    DEFINE PRIVATE STATIC VARIABLE sFloor  AS Tile NO-UNDO.

    CONSTRUCTOR STATIC TetrisArt():
        sBlank = NEW Tile("5555555555555555/5111111111111115/5122222222222245/5122222222222445/5122112222222445/5122122222222445/5122222222222445/5123333333333445/5123333333333445/5123333333333445/5123333333333445/5123333333333445/5123333333333445/5124444444444445/5144444444444445/5555555555555555").
        sBlocks[1] = NEW Tile("5555555555555555/5111111111111115/5122222222222245/5122222222222445/5122112222222445/5122122222222445/5122222222222445/5123555555553445/5123555555551445/5123311111111445/5123333333333445/5123333333333445/5123333333333445/5124444444444445/5144444444444445/5555555555555555").  /* I */
        sBlocks[2] = NEW Tile("5555555555555555/5111111111111115/5122222222222245/5122222222222445/5122112222222445/5122155555522445/5122251111512445/5123351333513445/5123351333513445/5123351333513445/5123355555513445/5123331111113445/5123333333333445/5124444444444445/5144444444444445/5555555555555555").  /* O */
        sBlocks[3] = NEW Tile("5555555555555555/5111111111111115/5122222222222245/5122222222222445/5122112552222445/5122122551222445/5122222551222445/5123555555553445/5123555555551445/5123311551111445/5123333551333445/5123333551333445/5123333311333445/5124444444444445/5144444444444445/5555555555555555").  /* T */
        sBlocks[4] = NEW Tile("5555555555555555/5111111111111115/5122222222222245/5122222222222445/5122112222252445/5122122222551445/5122222225511445/5123333355113445/5123333551133445/5123335511333445/5123355113333445/5123551133333445/5123311333333445/5124444444444445/5144444444444445/5555555555555555").  /* S */
        sBlocks[5] = NEW Tile("5555555555555555/5111111111111115/5122222222222245/5122222222222445/5122552222222445/5122155222222445/5122225522222445/5123333553333445/5123333355333445/5123333335533445/5123333333553445/5123333333351445/5123333333331445/5124444444444445/5144444444444445/5555555555555555").  /* Z */
        sBlocks[6] = NEW Tile("5555555555555555/5111111111111115/5122222222222245/5122222222222445/5122112225522445/5122122225512445/5122222225512445/5123333335513445/5123333335513445/5123333335513445/5123555555513445/5123555555513445/5123311111113445/5124444444444445/5144444444444445/5555555555555555").  /* J */
        sBlocks[7] = NEW Tile("5555555555555555/5111111111111115/5122222222222245/5122222222222445/5122155222222445/5122155122222445/5122255122222445/5123355133333445/5123355133333445/5123355133333445/5123355555553445/5123355555551445/5123331111111445/5124444444444445/5144444444444445/5555555555555555").  /* L */
        sGhost = NEW Tile(".DDDDDDDDDDDDDD./D..............D/D.H...H...H....D/D....H...H...H.D/D...H...H...H..D/D..H...H...H...D/D.H...H...H....D/D....H...H...H.D/D...H...H...H..D/D..H...H...H...D/D.H...H...H....D/D....H...H...H.D/D...H...H...H..D/D..H...H...H...D/D..............D/.DDDDDDDDDDDDDD.").
        sFloor = NEW Tile("FFFFFFFFFFFFFFFG/FFFFFFFFFFFFFFFG/FFFFFFFFFFFFFFFG/FFFFFFFFFFFFFFFG/FFFFFFFFFFFFFFFG/FFFFFFFFFFFFFFFG/FFFFFFFFFFFFFFFG/FFFFFFFFFFFFFFFG/FFFFFFFFFFFFFFFG/FFFFFFFFFFFFFFFG/FFFFFFFFFFFFFFFG/FFFFFFFFFFFFFFFG/FFFFFFFFFFFFFFFG/FFFFFFFFFFFFFFFG/FFFFFFFFFFFFFFFG/GGGGGGGGGGGGGGGG").
    END CONSTRUCTOR.

    /* The block of a piece (1 to 7: I O T S Z J L) with its mark. Throws GridException for any other number. */
    METHOD PUBLIC STATIC Tile Block(INPUT piPiece AS INTEGER):
        IF piPiece = ? OR piPiece < 1 OR piPiece > 7 THEN UNDO, THROW NEW GridException("A piece is 1 to 7, not " + STRING(piPiece)).
        RETURN sBlocks[piPiece].
    END METHOD.

    /* The block without a mark. */
    METHOD PUBLIC STATIC Tile BlockBlank():
        RETURN sBlank.
    END METHOD.

    /* The hollow, hatched ghost, with its four corner pixels left out. */
    METHOD PUBLIC STATIC Tile Ghost():
        RETURN sGhost.
    END METHOD.

    /* An empty cell of the well: 15 x 15 of F with a line of G down its right side and along its bottom. */
    METHOD PUBLIC STATIC Tile Floor():
        RETURN sFloor.
    END METHOD.

END CLASS.
