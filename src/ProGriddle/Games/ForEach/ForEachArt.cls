            WHEN ForEachPicture:CrashPop2 THEN RETURN "S=FFFFFF,X=FFE6B0".
            WHEN ForEachPicture:Stars THEN RETURN "S=FFD23A".
            WHEN ForEachPicture:Zz THEN RETURN "Z=F4F2FF".
            WHEN ForEachPicture:Rewind THEN RETURN "K=7FF0FF".
            WHEN ForEachPicture:DibbyGiant THEN RETURN "E=FFFFFF,L=5CFF8A,M=5A1A2A,P=1C2A8C".
            OTHERWISE RETURN "".
        END CASE.
    END METHOD.

    /* The colour row whose tones the picture uses, or unknown for a picture with no tones. Phantom pictures are drawn in the row of
       the phantom, which the caller chooses. */
    METHOD PUBLIC STATIC ForEachRow ToneRow(INPUT poPicture AS ForEachPicture):
        CASE poPicture:
            WHEN ForEachPicture:DibbyClosed THEN RETURN ForEachRow:Dibby.
            WHEN ForEachPicture:DibbyHalf THEN RETURN ForEachRow:Dibby.
            WHEN ForEachPicture:DibbyWide THEN RETURN ForEachRow:Dibby.
            WHEN ForEachPicture:DibbyHappy THEN RETURN ForEachRow:Dibby.
            WHEN ForEachPicture:DibbyLife THEN RETURN ForEachRow:Dibby.
            WHEN ForEachPicture:MarkMary THEN RETURN ForEachRow:Mary.
            WHEN ForEachPicture:MarkRich THEN RETURN ForEachRow:Rich.
            WHEN ForEachPicture:Rolledback1 THEN RETURN ForEachRow:Rollback.
            WHEN ForEachPicture:Rolledback2 THEN RETURN ForEachRow:Rollback.
            WHEN ForEachPicture:Flash1 THEN RETURN ForEachRow:Flash.
            WHEN ForEachPicture:Flash2 THEN RETURN ForEachRow:Flash.
            WHEN ForEachPicture:ItemFloppy THEN RETURN ForEachRow:Steel.
            WHEN ForEachPicture:Crash1 THEN RETURN ForEachRow:Dibby.
            WHEN ForEachPicture:Crash2 THEN RETURN ForEachRow:Dibby.
            WHEN ForEachPicture:Crash3 THEN RETURN ForEachRow:Dibby.
            WHEN ForEachPicture:Crash4 THEN RETURN ForEachRow:Dibby.
            WHEN ForEachPicture:Crash5 THEN RETURN ForEachRow:Dibby.
            WHEN ForEachPicture:Crash6 THEN RETURN ForEachRow:Dibby.
            WHEN ForEachPicture:Crash7 THEN RETURN ForEachRow:Dibby.
            WHEN ForEachPicture:DibbyGiant THEN RETURN ForEachRow:Dibby.
